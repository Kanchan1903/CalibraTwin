# CalibraTwin Backend Environment Configuration

# Service
PROJECT_NAME="CalibraTwin"
API_V1_STR="/api"
SECRET_KEY="calibratwin-production-secure-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Neon PostgreSQL or Local PostgreSQL)
# For local dev / demo: sqlite:///./calibratwin.db
# For production Neon / Render: postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/calibratwin?sslmode=require
DATABASE_URL="sqlite:///./calibratwin.db"

# MQTT Broker Configuration
MQTT_ENABLED=false
MQTT_BROKER="broker.emqx.io"
MQTT_PORT=1883
MQTT_USER=""
MQTT_PASSWORD=""
MQTT_TLS=false

# Calibration Safety Envelope
MAX_CALIBRATION_OFFSET_KPA=5.0
MAX_CALIBRATION_GAIN_DELTA=0.15
MAX_RETRY_COUNT=2
